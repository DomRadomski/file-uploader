<!DOCTYPE html>
<html>
<head><title><%= folder.name %></title></head>
<body>
  <h1><%= folder.name %></h1>

  <p>
    <a href="/folders/<%= folder.id %>/update">Rename</a> |
    <form method="POST" action="/folders/<%= folder.id %>/delete" style="display: inline;">
      <button type="submit" onclick="return confirm('Delete this folder and everything in it?')">Delete folder</button>
    </form>
  </p>

  <h2>Files</h2>
  <% if (folder.files.length === 0) { %>
    <p>No files in this folder yet.</p>
  <% } else { %>
    <ul>
      <% folder.files.forEach((file) => { %>
        <li><a href="/files/<%= file.id %>"><%= file.originalName %></a> (<%= file.size %> bytes)</li>
      <% }) %>
    </ul>
  <% } %>

  <h3>Upload a file to this folder</h3>
  <form method="POST" action="/folders/<%= folder.id %>/upload" enctype="multipart/form-data">
    <input type="file" name="file" required />
    <button type="submit">Upload</button>
  </form>

  <h3>Share this folder</h3>
  <form method="POST" action="/folders/<%= folder.id %>/share">
    <select name="duration">
        <option value="1h">1 hour</option>
        <option value="24h" selected>24 hours</option>
        <option value="7d">7 days</option>
        <option value="30d">30 days</option>
    </select>
    <button type="submit">Generate share link</button>
  </form>

<% if (shareUrl) { %>
  <p>Share link: <a href="<%= shareUrl %>"><%= shareUrl %></a></p>
<% } %>

  <p><a href="/folders">Back to folders</a></p>
</body>
</html>